# Safe local-development placeholders. Copy to .env and change the password.
POSTGRES_DB=spotyourslot
POSTGRES_USER=spotyourslot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
ALLOWED_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
# Explicitly opt in when creating the first local platform administrator.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-local-only-password
